# ==========================================
# Moroccan Secrets - Environment Configuration
# ==========================================

# Application Site URL
VITE_SITE_URL="https://moroccansecrets.com"
APP_URL="http://localhost:8080"

# Supabase Public Configuration (Accessible in browser and SSR)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase Server-side Configuration (Never expose service role key to client)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_PROJECT_ID="your-project-id"

# Scheduled Tasks / Cron Secret
CRON_SECRET="your-cron-secret-key"
CRON_SECRET_PREVIOUS=""

# Email Delivery (Resend)
# Optional in development: when left blank, a safe log-only fallback is used
RESEND_API_KEY=""
NOTIFICATION_EMAIL_TO="hello@moroccansecrets.com"
NOTIFICATION_EMAIL_FROM="Moroccan Secrets <bookings@moroccansecrets.com>"

# Host WhatsApp Contact (digits only, e.g. 212600000000)
OWNER_WHATSAPP_NUMBER=""
PUBLIC_CONTACT_EMAIL=""
INSTAGRAM_URL=""

# Booking: provide only real, reviewed content before accepting requests.
BOOKING_CURRENCY=""
BOOKING_RATE_LIMIT_SECRET=""
CANCELLATION_POLICY_EN=""
CANCELLATION_POLICY_FR=""
CANCELLATION_POLICY_AR=""
# Random secret of at least 32 characters for signed one-time guest review links
REVIEW_TOKEN_SECRET=""

# Optional public review profiles (HTTPS URLs; hidden when empty)
TRIPADVISOR_REVIEWS_URL=""
GOOGLE_BUSINESS_REVIEWS_URL=""

# Public inquiry forms fail closed without this secret and Cloudflare client IP headers.
PUBLIC_FORM_RATE_LIMIT_SECRET=""
